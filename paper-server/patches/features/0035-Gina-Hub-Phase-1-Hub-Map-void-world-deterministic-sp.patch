From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maj Kovacic <majkovacic9@gmail.com>
Date: Thu, 13 Aug 2026 18:11:12 +0200
Subject: [PATCH] Gina-Hub Phase 1: Hub-Map void world, deterministic spawn,
 world border, simulation gamerule defaults


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index d44219d820d6d4586492da40f1d7f9303982c86d..2167134344dbae9adf1340b96be5c769d5afebe4 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -740,6 +740,14 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             try {
                 setInitialSpawn(serverLevel, serverLevelData, worldOptions.generateBonusChest(), isDebugWorld, serverLevel.levelLoadListener); // Paper - per world level load listener
                 serverLevelData.setInitialized(true);
+                // Gina start - apply the configured initial world border, centered on spawn, to freshly created worlds
+                if (serverLevel.dimension() == net.minecraft.world.level.Level.OVERWORLD) {
+                    net.minecraft.core.BlockPos spawnPos = serverLevelData.getRespawnData().pos();
+                    net.minecraft.world.level.border.WorldBorder worldBorder = serverLevel.getWorldBorder();
+                    worldBorder.setCenter(spawnPos.getX() + 0.5, spawnPos.getZ() + 0.5);
+                    worldBorder.setSize(serverLevel.paperConfig().hub.initialBorderSize);
+                }
+                // Gina end
                 if (isDebugWorld) {
                     this.setupDebugLevel(this.worldData);
                 }
@@ -809,6 +817,16 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             levelData.setSpawn(LevelData.RespawnData.of(level.dimension(), BlockPos.ZERO.above(80), 0.0F, 0.0F));
         } else {
             ServerChunkCache chunkSource = level.getChunkSource();
+            // Gina start - void Hub worlds are empty by design; skip vanilla's ground-search spawn logic
+            // (it assumes solid terrain exists) and place a deterministic single-block spawn platform instead.
+            if (level.generator == null && chunkSource.getGenerator() instanceof net.minecraft.world.level.levelgen.FlatLevelSource flatLevelSource
+                && flatLevelSource.settings().getLayers().isEmpty()) {
+                BlockPos spawnPos = new BlockPos(0, 65, 0);
+                level.setBlockAndUpdate(spawnPos.below(), net.minecraft.world.level.block.Blocks.BEDROCK.defaultBlockState());
+                levelData.setSpawn(LevelData.RespawnData.of(level.dimension(), spawnPos, 0.0F, 0.0F));
+                return;
+            }
+            // Gina end
             // CraftBukkit start
             if (level.generator != null) {
                 java.util.Random rand = new java.util.Random(level.getSeed());
diff --git a/net/minecraft/server/dedicated/DedicatedServerProperties.java b/net/minecraft/server/dedicated/DedicatedServerProperties.java
